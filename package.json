{
  "name": "varname",
  "version": "8.1.0",
  "type": "module",
  "description": "Convert strings between different variable naming formats",
  "keywords": [
    "camelcase",
    "camelback",
    "naming",
    "string",
    "variable"
  ],
  "author": "Rowan Manning (https://rowanmanning.com/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/rowanmanning/varname.git"
  },
  "homepage": "https://github.com/rowanmanning/varname",
  "bugs": "https://github.com/rowanmanning/varname/issues",
  "license": "MIT",
  "engines": {
    "node": "22.x || 24.x || 26.x"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "verify": "biome check",
    "test": "npm run test:unit",
    "test:unit": "node --test --experimental-test-coverage --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-lines=100 test/unit/**/*.test.ts",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^20.5.3",
    "@rowanmanning/biome-config": "^3.1.0",
    "@types/node": "^22.20.2",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "index.ts"
  ]
}
